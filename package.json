{
  "name": "backend",
  "version": "1.0.0",
  "description": "bifrost-api backend service",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "nodemon --exec ts-node --transpile-only src/main.ts",
    "dev:bootstrap": "bash ./scripts/dev-bootstrap.sh && npm run dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "smoke:items": "node test-api.js",
    "smoke:db": "node test-db.js",
    "build": "prisma generate && tsc",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/*.test.cjs",
    "test:e2e": "node --test tests/e2e/*.test.cjs",
    "test:watch": "npm run build && node --test --watch tests/*.test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vondraker/bifrost-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/vondraker/bifrost-api/issues"
  },
  "homepage": "https://github.com/vondraker/bifrost-api#readme",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.1.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
